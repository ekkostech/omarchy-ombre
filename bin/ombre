#!/usr/bin/env bash
# ombre: script the Ombre plugin from a shell or a keybinding.
#
#   ombre                      open the picker
#   ombre keep-running list|add|on|off|remove APP.desktop [WINDOW_CLASS]
#                            start selected desktop apps at login and keep them running
#   ombre studio               Matrix, focus, privacy, scenes and session map
#   ombre matrix on|off|pause|resume|size N|blur N|opacity N|speed N|density N
#   ombre signal STATUS PID     working, done, input or error for a session
#   ombre sessions [SEARCH]    find and jump to a terminal window, Omaguake tab or tmux pane
#   ombre red                  tint the focused terminal
#   ombre next                 cycle the focused terminal through the hues
#   ombre reset                clear the focused terminal
#   ombre blue --title api     tint every terminal whose title contains "api"
#   ombre '#203040' --pid 1234 any hex color; target a terminal by pid
#   ombre reset --all          clear every terminal
#   ombre mood:fire            an Aether mood from the current wallpaper
#   ombre mood:ocean@/path/to/wallpaper.jpg
#   ombre theme:tokyo-night    any installed Omarchy theme
#   ombre colour '#e0603a' [vivid|soft|warm|cool|contrast]   a full Aether palette made from one colour
#   ombre tone auto|dark|light moods follow the theme, or are always dark or light
#   ombre wallpaper /path/to/wallpaper.jpg [--strength 0.15] [--blur 12]  Ghostty or Omaguake
#   ombre wallpaper none       remove the focused terminal's wallpaper
#   ombre blur 12             blur the current wallpaper (0–40; 0 is off)
#   ombre setup-omaguake       enable Omaguake wallpapers (--undo reverts)
#   ombre setup-ghostty        let new Ghostty windows take wallpapers (--undo reverts)
#   ombre hide /path/to/wallpaper.jpg   hide a wallpaper from the picker's strips (file untouched); 'unhide' or 'unhide all'
#   ombre images add PATH...   add wallpapers from anywhere: PNG/JPEG files or whole folders (only read, never changed)
#   ombre images remove PATH   take an added file or folder back out of the picker (files untouched)
#   ombre images list          show the added files and folders and how many images each holds
#   ombre borders on|off       follow the look with the window border
#   ombre pulse on|off         pulse a terminal's border when its agent finishes
#   ombre shadow on|off        drop shadow under the text (Ghostty windows)
#   ombre glass on|off         frosted dark glass behind coloured blocks like Claude's message band (Ghostty wallpaper windows)
#   ombre glass color auto|smoke|red|...|'#2a1040'   glass colour (auto follows each terminal's look)
#   ombre glass tint 0-100     how much the colour covers the wallpaper (86 by default)
#   ombre glass blur 0-60      how soft the wallpaper behind the glass is (36 by default)
#   ombre glass reset | ombre glass   back to the defaults | show the glass settings
#   ombre solid on|off         Ghostty windows fully opaque (Omarchy dims windows a little; on by default)
#   ombre pulse now|stop       start or stop a pulse by hand (with a target)
#   ombre project from                 use the focused terminal's look for its project folder
#   ombre project set /path [LOOK] [--wallpaper FILE] [--strength 0.15]   define a rule
#   ombre project list                 show project rules
#   ombre project remove /path         drop a rule
#   ombre default none|auto    what new terminals get: nothing, or a different tint each
#   ombre default from         new terminals copy the focused (or targeted) terminal's look
#   ombre default theme:nord   new terminals get this look (any look value)
#   ombre save "Deep Ocean"       save the focused terminal's complete look
#   ombre look "Deep Ocean"       apply a saved look (targets work here too)
#   ombre --saved                 list saved looks and favourites
#   ombre saved favorite NAME     toggle a saved look's favourite star
#   ombre saved rename OLD NEW    rename a saved look
#   ombre saved remove NAME       remove a saved look
#   ombre undo | ombre redo       restore the targeted terminal's previous look
#   ombre --list               show terminals and their looks
#   ombre --looks              list the moods, themes and wallpapers
#   ombre --check              what's installed, and what moods and wallpapers still need
#
# Hues: red orange amber green teal blue purple pink
# Targets (styling/save/history): --title TEXT, --workspace NAME, --pid N, --address HEX, --all

set -euo pipefail

id="ekkostech.ombre"

usage() { awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} /^$/ {print; next} {exit}' "$0"; exit "${1:-0}"; }

call() {
  local out
  out=$(omarchy-shell shell call "$id" "$1" "$2")
  if [[ $out == unknown ]]; then
    echo "ombre: plugin not loaded; run: omarchy plugin enable $id" >&2
    exit 1
  fi
  [[ $out == error* ]] && { echo "ombre: $out" >&2; exit 1; }
  return 0
}

case ${1:-} in
  "") exec omarchy-shell shell toggle "$id" '{}' ;;
  -h|--help) usage ;;
  setup-omaguake)
    shift
    exec python3 "$(dirname "$(readlink -f "$0")")/ombre-setup-omaguake" "$@" ;;
  keep-running)
    case ${2:-list} in
      list) payload='{"op":"status"}' ;;
      add|on|off)
        payload=$(jq -nc --arg id "${3:?provide a desktop app ID, such as chatgpt.desktop}" --arg action "$2" '{op:"set",id:$id,enabled:($action!="off")}')
        if [[ $# -ge 4 ]]; then payload=$(jq -c --arg class "$4" '. + {class:$class}' <<< "$payload"); fi ;;
      remove) payload=$(jq -nc --arg id "${3:?provide the desktop app ID}" '{op:"remove",id:$id}') ;;
      *) echo "keep-running: list|add|on|off|remove APP.desktop [WINDOW_CLASS]" >&2; exit 1 ;;
    esac
    exec python3 -I "$(dirname "$(readlink -f "$0")")/ombre-keep-running" request "$payload" ;;
  studio)
    call open '{"studio":true}'; exit ;;
  matrix)
    shift
    case ${1:-on} in
      on|off) payload=$(jq -nc --arg on "${1:-on}" '{on:($on=="on")}') ;;
      pause|resume) payload=$(jq -nc --arg state "$1" '{paused:($state=="pause")}') ;;
      size|blur|opacity|speed|density) payload=$(jq -nc --arg key "$1" --argjson value "${2:?provide a number}" '{($key):$value}') ;;
      *) echo "matrix: on|off|pause|resume|size|blur|opacity|speed|density" >&2; exit 1 ;;
    esac
    call setMatrix "$payload"; exit ;;
  signal)
    call signal "$(jq -nc --arg status "${2:?working|done|input|error}" --arg pid "${3:-$PPID}" '{status:$status,pid:$pid}')"; exit ;;
  sessions)
    shift
    exec omarchy-shell shell summon "$id" "$(jq -nc --arg query "$*" '{sessions:true,query:$query}')" ;;
  --version) jq -r '"ombre " + .version' "$(dirname "$(readlink -f "$0")")/../manifest.json"; exit ;;
  --list)
    call state "" # the first call starts a fresh scan
    sleep 0.3
    omarchy-shell shell call "$id" state "" |
      jq -r '.terminals[] | [.workspace, .pty, (if .look == "" then "-" else .look end), .title] | @tsv'
    exit ;;
  --looks)
    omarchy-shell shell call "$id" looks "" |
      jq -r '"saved:  " + ([.saved[].name] | join(", ")), "moods:  " + (.moods | join(" ")), "colour: any #rrggbb, as classic vivid soft warm cool contrast", "themes: " + (.themes | join(" ")), "wallpapers:", (.wallpapers[] | "  " + .)'
    exit ;;
  --check)
    call looks "" # the first call refreshes what's installed
    sleep 0.5
    omarchy-shell shell call "$id" looks "" | jq -r '
      (if .aether then "✓ Aether \(.aetherVersion | sub("^aether "; "")): moods and colour palettes are available"
       elif .aetherInstalled then "✗ \(.aetherVersion) is too old for moods. Update with: omarchy update"
       else "✗ Aether is not installed, and moods need it. Install with: omarchy pkg add aether" end),
      (if .ghostty then "✓ Ghostty is installed"
       else "✗ Ghostty is not installed, and wallpapers need it. Install with: omarchy install terminal ghostty" end),
      (if .launcher then "✓ Ghostty launcher is set up: new Ghostty windows can take wallpapers"
       elif .ghostty then "✗ Ghostty launcher is not set up. Run: ombre setup-ghostty"
       else empty end)'
    exit ;;
  --saved)
    omarchy-shell shell call "$id" looks "" | jq -r '.saved[] | "\(if .favorite then "★" else "☆" end) \(.name)"'; exit ;;
  colour|color)
    [[ ${2:-} =~ ^#[0-9a-fA-F]{6}$ ]] || usage 1
    if [[ ${3:-} =~ ^(classic|vivid|soft|warm|cool|contrast)$ ]]; then set -- "colour:$2:$3" "${@:4}"
    else set -- "colour:$2" "${@:3}"; fi ;;
  tone)
    case ${2:-} in auto|dark|light) call setMoodTone "$2" ;; *) usage 1 ;; esac
    exit ;;
  blur)
    [[ ${2:-} =~ ^[0-9]+$ ]] && ((10#$2 <= 40)) || usage 1
    set -- "blur:$2" "${@:3}" ;;
  save|look)
    [[ -n ${2:-} ]] || usage 1
    if [[ $1 == save ]]; then set -- "save:$2" "${@:3}"
    else set -- "saved:$2" "${@:3}"; fi ;;
  saved)
    case ${2:-} in
      list) omarchy-shell shell call "$id" looks "" | jq -r '.saved[] | "\(if .favorite then "★" else "☆" end) \(.name)"' ;;
      favorite|favourite) [[ -n ${3:-} ]] || usage 1; call favoriteNamedLook "$3" ;;
      remove) [[ -n ${3:-} ]] || usage 1; call removeNamedLook "$3" ;;
      rename) [[ -n ${3:-} && -n ${4:-} ]] || usage 1; call renameSaved "$(jq -cn --arg from "$3" --arg to "$4" '{from:$from,to:$to}')" ;;
      *) usage 1 ;;
    esac
    exit ;;
  setup-ghostty)
    shift
    exec "$(dirname "$(readlink -f "$0")")/ombre-setup-ghostty" "$@" ;;
  wallpaper)
    [[ -n ${2:-} ]] || usage 1
    if [[ $2 == none ]]; then set -- "wallpaper:none" "${@:3}"
    else set -- "wallpaper:$(readlink -f "$2")" "${@:3}"; fi ;;
  images)
    case ${2:-} in
      add)
        (($# >= 3)) || usage 1
        for p in "${@:3}"; do
          p=$(realpath -s -m -- "$p")
          info=$(python3 -I "$(dirname "$(readlink -f "$0")")/ombre-images" "$p" | jq -r '.sources[0] | "\(.kind) \(.images | length)"')
          case ${info%% *} in
            missing) echo "ombre: $p was not found" >&2; exit 1 ;;
            unsupported) echo "ombre: $p is not a PNG or JPEG image (the formats Ghostty can show)" >&2; exit 1 ;;
          esac
          call addImageSource "$p"
          n=${info#* }
          echo "added $p ($n image$([[ $n == 1 ]] || echo s))"
        done ;;
      remove) [[ -n ${3:-} ]] || usage 1; call removeImageSource "$(realpath -s -m -- "$3")" ;;
      list) omarchy-shell shell call "$id" looks "" | jq -r '.imageSources[]? | "\(.path)\t\(.kind)\t\(.count)"' ;;
      *) usage 1 ;;
    esac
    exit ;;
  hide) [[ -n ${2:-} ]] || usage 1; call hideSource "$(readlink -f "$2")"; exit ;;
  unhide) [[ -n ${2:-} ]] || usage 1; [[ $2 == all ]] && call unhideSource "*" || call unhideSource "$(readlink -f "$2")"; exit ;;
  borders)
    case ${2:-} in on) call setBorders true ;; off) call setBorders false ;; *) usage 1 ;; esac
    exit ;;
  project)
    case ${2:-} in
      from) set -- "project:from" "${@:3}" ;;
      set)
        path=$(readlink -f "${3:?project set needs a path}"); look=""; wp=""; st=""; bl=""; shift 3
        [[ ${1:-} && $1 != --* ]] && { look=$1; shift; }
        while (($#)); do case $1 in --wallpaper) wp=$(readlink -f "$2"); shift 2 ;; --strength) st=$2; shift 2 ;; --blur) bl=$2; shift 2 ;; *) usage 1 ;; esac; done
        call defineProject "$(jq -cn --arg p "$path" --arg l "$look" --arg w "$wp" --arg s "$st" --arg b "$bl" '{path: $p} + (if $l == "" then {} else {look: $l} end) + (if $w == "" then {} else {wallpaper: $w} end) + (if $s == "" then {} else {strength: ($s|tonumber)} end) + (if $b == "" then {} else {blur: ($b|tonumber)} end)')"
        exit ;;
      list) omarchy-shell shell call "$id" looks "" | jq -r '.projects[] | "\(.path)\t\(.look)"'; exit ;;
      remove) [[ -n ${3:-} ]] || usage 1; call apply "$(jq -cn --arg v "project:remove:$(readlink -f "$3")" '{value: $v}')"; exit ;;
      *) usage 1 ;;
    esac ;;
  default)
    case ${2:-} in
      none|auto) call setDefaultMode "$2"; exit ;;
      "") usage 1 ;;
      *) set -- "default:$2" "${@:3}" ;;
    esac ;;
  shadow)
    case ${2:-} in on) call setTextShadow true ;; off) call setTextShadow false ;; *) usage 1 ;; esac
    exit ;;
  glass)
    case ${2:-} in
      "") omarchy-shell shell call "$id" looks "" | jq -r '.glass | "glass \(if .on then "on" else "off" end) · colour \(.color) · tint \(.tint) · blur \(.blur)"' ;;
      on) call setGlass true ;;
      off) call setGlass false ;;
      color|colour) [[ -n ${3:-} ]] || usage 1; call setGlassColor "$3" ;;
      tint) [[ ${3:-} =~ ^[0-9]+$ ]] && ((10#$3 <= 100)) || usage 1; call setGlassTint "$3" ;;
      blur) [[ ${3:-} =~ ^[0-9]+$ ]] && ((10#$3 <= 60)) || usage 1; call setGlassBlur "$3" ;;
      reset) call resetGlass "" ;;
      *) usage 1 ;;
    esac
    exit ;;
  solid)
    case ${2:-} in on) call setSolid true ;; off) call setSolid false ;; *) usage 1 ;; esac
    exit ;;
  pulse)
    case ${2:-} in
      on) call setPulse true; exit ;;
      off) call setPulse false; exit ;;
      now|stop) set -- "pulse:$2" "${@:3}" ;;
      *) usage 1 ;;
    esac ;;
esac

value=$1; shift
target=focused
strength=""
blur=""
while (($#)); do
  case $1 in
    --blur) blur="${2:?--blur needs an amount from 0 to 40}"; shift 2 ;;
    --strength) strength="${2:?--strength needs a number from 0.01 to 1 (soft is 0.08)}"; shift 2 ;;
    --title) target="title:${2:?--title needs text}"; shift 2 ;;
    --workspace) target="workspace:${2:?--workspace needs a workspace name or number}"; shift 2 ;;
    --pid) target="pid:${2:?--pid needs a number}"; shift 2 ;;
    --address) target="address:${2:?--address needs a window address}"; shift 2 ;;
    --all) target=all; shift ;;
    *) usage 1 ;;
  esac
done

call apply "$(jq -cn --arg value "$value" --arg target "$target" --arg strength "$strength" --arg blur "$blur" \
  '{value: $value, target: $target} + (if $strength == "" then {} else {strength: ($strength | tonumber)} end) + (if $blur == "" then {} else {blur: ($blur | tonumber)} end)')"
