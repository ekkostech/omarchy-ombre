#!/usr/bin/env bash
# terminal-tint: script the Terminal Tint plugin from a shell or a keybinding.
#
#   terminal-tint                      open the picker
#   terminal-tint red                  tint the focused terminal
#   terminal-tint next                 cycle the focused terminal through the hues
#   terminal-tint reset                clear the focused terminal
#   terminal-tint blue --title api     tint every terminal whose title contains "api"
#   terminal-tint '#203040' --pid 1234 any hex color; target a terminal by pid
#   terminal-tint reset --all          clear every terminal
#   terminal-tint mood:fire            an Aether mood from the current wallpaper
#   terminal-tint mood:ocean@/path/to/wallpaper.jpg
#   terminal-tint theme:tokyo-night    any installed Omarchy theme
#   terminal-tint wallpaper /path/to/wallpaper.jpg [--strength 0.15]  Ghostty only
#   terminal-tint wallpaper none       remove the focused terminal's wallpaper
#   terminal-tint setup-ghostty        let new Ghostty windows take wallpapers (--undo reverts)
#   terminal-tint borders on|off       follow the look with the window border
#   terminal-tint --list               show terminals and their looks
#   terminal-tint --looks              list the moods, themes and wallpapers
#
# Hues: red orange amber green teal blue purple pink
# Targets (any command): --title TEXT, --pid N, --address HEX, --all

set -euo pipefail

id="ekkostech.terminal-tint"

usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

call() {
  local out
  out=$(omarchy-shell shell call "$id" "$1" "$2")
  if [[ $out == unknown ]]; then
    echo "terminal-tint: plugin not loaded; run: omarchy plugin enable $id" >&2
    exit 1
  fi
  [[ $out == error* ]] && { echo "terminal-tint: $out" >&2; exit 1; }
  return 0
}

case ${1:-} in
  "") exec omarchy-shell shell toggle "$id" '{}' ;;
  -h|--help) usage ;;
  --list)
    call state "" # the first call starts a fresh scan
    sleep 0.3
    omarchy-shell shell call "$id" state "" |
      jq -r '.terminals[] | [.workspace, .pty, (if .look == "" then "-" else .look end), .title] | @tsv'
    exit ;;
  --looks)
    omarchy-shell shell call "$id" looks "" |
      jq -r '"moods:  " + (.moods | join(" ")), "themes: " + (.themes | join(" ")), "wallpapers:", (.wallpapers[] | "  " + .)'
    exit ;;
  setup-ghostty)
    shift
    exec "$(dirname "$(readlink -f "$0")")/terminal-tint-setup-ghostty" "$@" ;;
  wallpaper)
    [[ -n ${2:-} ]] || usage 1
    if [[ $2 == none ]]; then set -- "wallpaper:none" "${@:3}"
    else set -- "wallpaper:$(readlink -f "$2")" "${@:3}"; fi ;;
  borders)
    case ${2:-} in on) call setBorders true ;; off) call setBorders false ;; *) usage 1 ;; esac
    exit ;;
esac

value=$1; shift
target=focused
strength=""
while (($#)); do
  case $1 in
    --strength) strength="${2:?--strength needs a number from 0.01 to 1 (soft is 0.08)}"; shift 2 ;;
    --title) target="title:${2:?--title needs text}"; shift 2 ;;
    --pid) target="pid:${2:?--pid needs a number}"; shift 2 ;;
    --address) target="address:${2:?--address needs a window address}"; shift 2 ;;
    --all) target=all; shift ;;
    *) usage 1 ;;
  esac
done

call apply "$(jq -cn --arg value "$value" --arg target "$target" --arg strength "$strength" \
  '{value: $value, target: $target} + (if $strength == "" then {} else {strength: ($strength | tonumber)} end)')"
