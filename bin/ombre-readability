#!/usr/bin/env python3
import json,sys
from PIL import Image,ImageStat
def analyze(path):
    luminance=0.25
    if path:
        with Image.open(path) as image:
            image.thumbnail((128,128))
            values=sorted(image.convert('L').getdata())
            if values:luminance=values[int((len(values)-1)*0.9)]/255
    # Bright images need less exposure. These are visibility recommendations,
    # not a claim about every foreground/background pair in an application's UI.
    strength=round(max(0.12,min(0.35,0.32-luminance*0.18)),2)
    return dict(strength=strength,tint=round(45+luminance*25),blur=24,foreground='#edf3f5')
if __name__=='__main__':
    print(json.dumps(analyze(sys.argv[1] if len(sys.argv)>1 else '')))
