#!/usr/bin/env python3
"""Write one window's glass shader: shaders/glass.glsl with its colour, tint and blur.

Ghostty custom shaders take no settings, so Ombre gives each window its own copy
next to its config. The file name carries a hash of the contents: a change gives
Ghostty a new path, so the config reload recompiles it. Prints the path."""
import argparse
import hashlib
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

TEMPLATE = Path(__file__).resolve().parent.parent / "shaders" / "glass.glsl"


def linear(channel):
    c = channel / 255
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def render(template, color, tint, blur):
    if not re.fullmatch(r"[0-9a-fA-F]{6}", color):
        raise ValueError("Glass colour must be six hex digits.")
    tint, blur = int(tint), int(blur)
    if not 0 <= tint <= 100 or not 0 <= blur <= 60:
        raise ValueError("Glass tint is 0-100 and blur 0-60.")
    r, g, b = (linear(int(color[i:i + 2], 16)) for i in (0, 2, 4))
    values = {
        "TINT": f"const vec3 TINT = vec3({r:.5f}, {g:.5f}, {b:.5f});   // #{color.lower()}, in linear light",
        "AMOUNT": f"const float AMOUNT = {tint / 100:.2f};",
        "RADIUS": f"const float RADIUS = {blur:.1f};",
    }
    for name, line in values.items():
        template, n = re.subn(rf"^const (?:vec3|float) {name} = .*$", line, template, flags=re.M)
        if n != 1:
            raise ValueError(f"glass.glsl has no single {name} line.")
    return template


def write(folder, pid, text):
    folder = Path(folder)
    info = folder.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise ValueError("Shader folder must be a directory owned by you.")
    if not re.fullmatch(r"[0-9]+", pid):
        raise ValueError("Invalid window pid.")
    target = folder / f"{pid}-glass-{hashlib.sha256(text.encode()).hexdigest()[:12]}.glsl"
    for old in folder.glob(f"{pid}-glass-*.glsl"):
        if old != target:
            old.unlink()
    if not target.exists():
        fd, temporary = tempfile.mkstemp(prefix=".glass-", suffix=".glsl", dir=folder)
        try:
            with os.fdopen(fd, "w") as f:
                f.write(text)
            os.replace(temporary, target)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    return target


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dir", required=True)
    parser.add_argument("--pid", required=True)
    parser.add_argument("--color", required=True)
    parser.add_argument("--tint", required=True)
    parser.add_argument("--blur", required=True)
    args = parser.parse_args()
    try:
        text = render(TEMPLATE.read_text(), args.color, args.tint, args.blur)
        print(write(args.dir, args.pid, text))
    except Exception as error:
        print("Cannot write glass shader: " + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
